---
import PageLayout from '@/layouts/PageLayout.astro';
import PrivacyPolicy from '@/content/privacy-policy.mdx';
import settings from '@/data/settings.json';
const { site_name, brand, legal_entity, legal_inn, legal_city, phone_common, email_common } = settings;
import scripts from '@/data/scripts.json';
const { site } = scripts;
import salonsData from '@/data/salons.json';
import type { ISalon } from '@/types/ISalon';
const salons = salonsData.filter((salon: ISalon) => !salon?.type || salon?.type.includes('privacy_policy'));
const common_text = legal_entity && legal_inn ? 

`<p>Политика обработки и защиты персональных данных посетителей веб-сайта применяется в дополнение к общей Политике обработки и защиты персональных данных работников ООО «АвтоДом» и иных лиц, составлена в соответствии с требованиями Федерального закона от 27.07.2006. №152-ФЗ «О персональных данных» (далее - Закон о персональных данных) и Рекомендаций Федеральной службы по надзору в сфере связи и массовых коммуникаций от 27 июля 2017 года.</p>
<p>Политика <strong>предназначена</strong> для доведения до субъектов персональных данных сведений о порядке обработки персональных данных и мерах по обеспечению безопасности персональных данных владельцем сайта (далее – Оператор).</p>` : 

const contact_text = salons
    .filter(salon => (salon?.name && salon?.name !== '' || salon?.legal_entity && salon?.legal_entity !== ''))
    .map(s => `<p class="not-last:border-b not-last:pb-4">` +
        `${s?.legal_entity || s?.name || legal_entity ? `- Наименование организации: <b>${s?.legal_entity || s?.name || legal_entity}</b><br />` : ''}` +
        `${s?.legal_inn || legal_inn ? `- ИНН: <b>${s?.legal_inn || legal_inn}</b><br />` : ''}` +
        `${s?.address ? `- Юридический адрес: <b>${s?.address}</b><br />` : ''}` +
        `${s?.phone ? `- Телефон: <b>${s?.phone}</b><br />` : ''}` +
        `${s?.email ? `- Электронная почта: <b>${s?.email}</b>` : ''}` +
    `</p>`).join('');
---

<PageLayout
    h1="Политика конфиденциальности"
    title="Политика конфиденциальности"
    description={`Политика конфиденциальности ${brand} ${legal_city}: цели и правовые основания обработки персональных данных по 152-ФЗ, перечень данных, права пользователя и контакты оператора.`}
    breadcrumb={[{name:"Политика конфиденциальности",href:""}]}
>

<h2 class="!static !ml-0 !text-2xl !my-8">Общие положения</h2>

<p set:html={common_text} />

<PrivacyPolicy />

<Fragment set:html={contact_text} />


</PageLayout>